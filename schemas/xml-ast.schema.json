{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:font-format-schema:xml-ast",
  "title": "Ordered XML AST",
  "$ref": "#/$defs/XmlElement",
  "$defs": {
    "XmlElement": {
      "type": "object",
      "required": [
        "tag",
        "attributes",
        "children"
      ],
      "properties": {
        "tag": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlElement"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
