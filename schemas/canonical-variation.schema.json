{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:font-format-schema:canonical-variation",
  "title": "Canonical variation-oriented font source model",
  "$defs": {
    "Axis": {
      "type": "object",
      "required": [
        "name",
        "tag",
        "default"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "tag": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4
        },
        "minimum": {
          "type": "number"
        },
        "default": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "DecomposedTransform": {
      "type": "object",
      "properties": {
        "translateX": {
          "type": "number"
        },
        "translateY": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        },
        "scaleX": {
          "type": "number"
        },
        "scaleY": {
          "type": "number"
        },
        "skewX": {
          "type": "number"
        },
        "skewY": {
          "type": "number"
        },
        "tCenterX": {
          "type": "number"
        },
        "tCenterY": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "VariableComponent": {
      "type": "object",
      "required": [
        "base"
      ],
      "properties": {
        "base": {
          "type": "string"
        },
        "location": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "transformation": {
          "$ref": "#/$defs/DecomposedTransform"
        },
        "resetUnspecifiedAxes": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "AffineComponent": {
      "type": "object",
      "required": [
        "base",
        "transform"
      ],
      "properties": {
        "base": {
          "type": "string"
        },
        "transform": {
          "type": "object",
          "required": [
            "xScale",
            "xyScale",
            "yxScale",
            "yScale",
            "xOffset",
            "yOffset"
          ],
          "properties": {
            "xScale": {
              "type": "number"
            },
            "xyScale": {
              "type": "number"
            },
            "yxScale": {
              "type": "number"
            },
            "yScale": {
              "type": "number"
            },
            "xOffset": {
              "type": "number"
            },
            "yOffset": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Axis"
    },
    {
      "$ref": "#/$defs/VariableComponent"
    },
    {
      "$ref": "#/$defs/AffineComponent"
    }
  ]
}
