{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:font-format-schema:designspace-normalized",
  "type": "object",
  "required": [
    "formatVersion",
    "axes",
    "mappings",
    "sources",
    "instances",
    "rules"
  ],
  "properties": {
    "path": {
      "type": "string"
    },
    "formatVersion": {
      "type": "string"
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "tag",
          "default"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "minimum": {
            "type": [
              "number",
              "null"
            ]
          },
          "default": {
            "type": "number"
          },
          "maximum": {
            "type": [
              "number",
              "null"
            ]
          },
          "hidden": {
            "type": "boolean"
          },
          "map": {
            "type": "array"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input",
          "output"
        ],
        "properties": {
          "input": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "output": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "location"
        ],
        "properties": {
          "location": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "location"
        ],
        "properties": {
          "location": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "rules": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
